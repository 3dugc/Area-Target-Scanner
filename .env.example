# Copy to .env for the local loopback-only Docker Compose service.
# Production Portainer requires its own username/hash variables and HTTPS.
AREA_TARGET_USERNAME=
# Generate: python -m web_service.auth hash-password
# Keep the generated scrypt hash inside single quotes to preserve its $ characters.
AREA_TARGET_PASSWORD_HASH=''
# 0 is only for local HTTP development; production always uses secure cookies.
AREA_TARGET_COOKIE_SECURE=0
